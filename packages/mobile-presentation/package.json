{
  "name": "dsh-mobile-presentation",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 移动端表现层：正文排版、留白、对比度、原生触感与深色微调。<=1023px 生效，桌面零影响。",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "styles",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check"
  }
}
