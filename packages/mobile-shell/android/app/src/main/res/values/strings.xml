    <!-- Setup -->
    <string name="setup_title">连接到你的 DSH 服务器</string>
    <string name="setup_hint">只需要填服务器地址。App 会打开该服务器的 dsh-passwords 登录页，
        用你在那台机器上的账号登录，登录凭证只加密保存在本机。</string>
    <string name="setup_endpoint_hint">https://dsh.example.com</string>
    <string name="setup_allow_insecure">允许 HTTP / 自签证书（不安全，仅局域网调试用）</string>
    <string name="setup_connect">连接并登录</string>
    <string name="setup_save_anyway">仍然保存并继续</string>
    <string name="setup_security_note">登录凭证（网关 token）用 Android Keystore 加密后存在本机，
        不会上传到任何第三方，也不会出现在日志里。</string>
    <string name="setup_probing">正在探测 %1$s …</string>
