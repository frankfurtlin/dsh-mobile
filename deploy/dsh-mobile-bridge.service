[Unit]
Description=DSH Mobile bridge (MCP endpoint + phone WebSocket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=~/workspace/dsh-mobile/packages/bridge-server
Environment=DSH_BRIDGE_PUBLIC_ORIGIN=https://dsh.example.com
Environment=DSH_BRIDGE_GATEWAY=http://127.0.0.1:3081
# Build artifacts a logged-in browser may fetch at /bridge/download/<file>.
Environment=DSH_BRIDGE_DOWNLOAD_DIR=~/workspace/dsh-mobile/dist
Environment=DSH_BRIDGE_DOWNLOAD_PATH=/bridge/download
ExecStart=~/.nvm/versions/node/v24.21.0/bin/node src/index.js
Restart=always
RestartSec=2

# The bridge is loopback-only; it never needs to reach beyond this host.
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
