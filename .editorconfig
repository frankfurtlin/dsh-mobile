# Keep every contributor's editor producing the same bytes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[{*.java,*.gradle}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.sh]
# The scripts pass `shellcheck`; keep the existing style.
indent_size = 2
