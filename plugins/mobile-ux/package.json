{
  "name": "dsh-mobile-ux",
  "version": "0.2.0",
  "private": true,
  "description": "DSH 移动端 UX 层（骨架 + 观感合一）：overlay 抽屉/安全区/PWA/canary 防失效 + 正文排版/对比度/原生触感。<=1023px 生效，桌面零影响。",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "styles",
    "vendor",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check"
  }
}
